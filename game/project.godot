; Godot 4.7.2 — open this file in the editor, then press F6/F5.
config_version=5

[application]
config/name="저승 보따리 — 첫 인도"
config/version="0.21.1"
run/main_scene="res://scenes/launch.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=1024
window/size/min_height=576
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="fractional"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.09, 1)

[debug]
file_logging/enable_file_logging=false
