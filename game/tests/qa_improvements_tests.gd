extends SceneTree
var checks := 0
var failures := 0
func check(ok: bool, message: String) -> void:
	checks += 1
	if not ok:
		failures += 1
		push_error(message)
func _initialize() -> void:
	call_deferred("_run")
func _run() -> void:
	var main := (load("res://scenes/main.tscn") as PackedScene).instantiate()
	main.save_enabled = false
	root.add_child(main)
	await process_frame
	check(main.theme.default_font is FontVariation and main.theme.default_font.base_font.resource_path.ends_with("NotoSansKR.ttf") and main.theme.default_font.variation_opentype.get(0x77676874) == 600, "game UI uses the readable outline font at a legible weight")
	check(main.layout.guide.heading.text == "Prepare Your Bag", "shipping guide is English")
	var legacy_name := "".join([String.chr(0xc800), String.chr(0xc2b9), " ", String.chr(0xbcf4), String.chr(0xb530), String.chr(0xb9ac), " — ", String.chr(0xccab), " ", String.chr(0xc778), String.chr(0xb3c4)])
	check(ProjectSettings.get_setting("application/config/name") == legacy_name and ProjectSettings.globalize_path("user://").trim_suffix("/").get_file() == legacy_name, "legacy user data directory remains discoverable")
	var old_raw: Dictionary = ContentLoader.new().load_json(ItemCatalog.DEFAULT_PATH).raw
	old_raw.rewards[0].item_ids = "rope|sandals|mirror"
	var previous := ItemCatalog.from_validated(ContentLoader.new().validate(old_raw).raw)
	var directory := ProjectSettings.globalize_path("res://../build/qa-improvements/%d" % OS.get_process_id())
	DirAccess.make_dir_recursive_absolute(directory)
	var path := directory.path_join("old-run.json")
	var old_text := SaveCodec.encode(CombatResolver.new(previous).snapshot(), previous, [])
	var old_file := FileAccess.open(path, FileAccess.WRITE)
	old_file.store_string(old_text)
	old_file.close()
	var loaded := SaveService.new(path).load_slot(ItemCatalog.create_inventory())
	check(loaded.status == "incompatible" and FileAccess.get_file_as_string(path) == old_text, "old reward data preserves incompatible save")
	var state: Dictionary = main.session.display_snapshot()
	state.phase = "battle"
	state.enemy_health = 1
	main.session.reset(main.inventory, state)
	check(main.session.submit({"type":"use_item", "uid":"sword"}).is_empty(), "first encounter can be won")
	main.session.skip_playback()
	var reward: Dictionary = main.session.display_snapshot().reward
	check(reward.candidates == ["rope", "sandals", "order"], "first accessible reward offers three distinct items")
	check(main.session.submit({"type":"reward_select", "offer_id":reward.offer_id, "item_id":"order"}).is_empty(), "reaper writ can be selected")
	main.session.skip_playback()
	check(main.session.stash("hat").is_empty() and main.session.place(reward.uid, Vector2i(1,2), 0).is_empty(), "writ requires meaningful bag space")
	check(main.session.submit({"type":"reward_confirm", "offer_id":reward.offer_id}).is_empty(), "writ can be confirmed")
	main.session.skip_playback()
	check(main.session.display_snapshot().phase == "victory" and main.session.display_snapshot().packed_items.has(reward.uid), "confirmed writ remains equipped")
	check(main.session.submit({"type":"advance"}).is_empty(), "continue to the evidence event")
	main.session.skip_playback()
	var event: Dictionary = main.session.display_snapshot().event
	check(main.session.submit({"type":"event_take", "event_id":event.id}).is_empty(), "mirror evidence remains accessible from event")
	main.session.skip_playback()
	check(main.session.display_snapshot().inventory_items.has(event.uid), "event creates mirror separately from the reward")
	# Effects are generated by the real simulator and only replay recorded snapshots.
	main._reset_run()
	main.session.submit({"type":"start"})
	main.session.skip_playback()
	var before: Dictionary = main.session.display_snapshot()
	var damage := CombatSimulator.resolve(before, {"type":"use_item", "uid":"sword"})
	var hit: Dictionary = damage.events().filter(func(entry): return entry.kind == "damage")[0]
	main.session.playback.reset(before)
	main.session.playback.play(CombatResolution.new(before, hit.after, [hit]))
	main.session.playback.queue._process(0)
	check(main.session.playback._impactful and main.road.feedback_damage > 0 and not main.road.feedback_impact, "nonlethal damage prepares hit effect without revealing state")
	main.session.playback.queue._current._impact()
	check(main.session.display_snapshot() == hit.after and main.road.feedback_impact and main.road.feedback_overlay.get_index() > main.road.enemy_sprite.get_index(), "damage text appears above sprite at the matching snapshot")
	check(main.sounds.player.stream == PresentationSound.CUES.hit, "damage uses the hit sound")
	main.session.skip_playback()
	check(not main.road.feedback_impact and main.road.feedback_damage == 0, "skip clears the hit")
	var guard_result := CombatSimulator.resolve(before, {"type":"use_item", "uid":"hat"})
	var guard: Dictionary = guard_result.events().filter(func(entry): return entry.kind == "guard")[0]
	main.session.playback.reset(before)
	main.session.playback.play(CombatResolution.new(before, guard.after, [guard]))
	main.session.playback.queue._process(0)
	main.session.playback.queue._current._impact()
	check(main.road.feedback_guard_change == 5 and main.road.feedback_target == "player", "guard rune uses the recorded increase and target")
	check(main.sounds.player.stream == PresentationSound.CUES.guard, "guard uses its own sound")
	main.session.skip_playback()
	check(main.road.feedback_guard_change == 0, "skip clears guard effect")
	var shielded := before.duplicate(true)
	shielded.enemy_guard = 50
	var blocked_result := CombatSimulator.resolve(shielded, {"type":"use_item", "uid":"sword"})
	var blocked: Dictionary = blocked_result.events().filter(func(entry): return entry.kind == "damage")[0]
	main.session.playback.reset(shielded)
	main.session.playback.play(CombatResolution.new(shielded, blocked.after, [blocked]))
	main.session.playback.queue._process(0)
	main.session.playback.queue._current._impact()
	check(main.road.feedback_damage == 0 and main.road.feedback_absorbed > 0 and not main.session.playback._impactful, "blocked attack uses defense effect without health-hit stop")
	check(main.sounds.player.stream == PresentationSound.CUES.guard, "blocked attack uses defense sound")
	main.session.skip_playback()
	main.queue_free()
	await process_frame
	print("QA IMPROVEMENTS: %d checks, %d failures" % [checks, failures])
	quit(1 if failures else 0)
